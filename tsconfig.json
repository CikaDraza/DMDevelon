{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": true,
    // The app is plain JavaScript and has never been type-checked; turning
    // `checkJs` on surfaces ~1400 pre-existing findings (mostly React Query
    // mutation generics inferring `void`, and Radix forwardRef prop inference)
    // that are noise, not defects. Left off so `tsc` and `next build` report
    // real problems — module resolution, syntax, JSX validity, and any .ts/.tsx
    // added from here on — instead of a wall no one reads.
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".dump",
    ".vault",
    "test_reports"
  ]
}
