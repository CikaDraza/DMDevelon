# MongoDB Connection
MONGO_URL=mongodb://localhost:27017
DB_NAME=portfolio_db

# Application URL (change for production)
APP_ENV=local
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*

# Fail-closed boundaries when APP_ENV=staging. DB_NAME itself is scoped per
# deployment environment: Production and Preview use different values. The
# production deny lists below never contain credentials or connection strings.
STAGING_CANONICAL_ORIGIN=https://staging.dmdevelon.website
PRODUCTION_DB_NAMES=portfolio_db
PRODUCTION_APP_ORIGINS=https://dmdevelon.website,https://www.dmdevelon.website

# Destructive database seeding is allowed only with APP_ENV=local and this
# explicit opt-in. Keep false/unset in every deployed environment.
ALLOW_DB_SEED=false

# Cloudinary (for image uploads)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret
CLOUDINARY_FOLDER=portfolio

# If Cloudinary is enabled in staging, all provider credentials above plus
# these boundaries are required. Prefer a separate restricted provider account.
STAGING_CLOUDINARY_NAME=
PRODUCTION_CLOUDINARY_NAMES=

# Email (SMTP)
EMAIL_SERVER=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password

# JWT Secret (generate a secure random string)
JWT_SECRET=your_jwt_secret_here

# Resend (transactional email)
RESEND_API_KEY=your_resend_api_key

# Exact comma-separated staging accounts that may receive either email or push.
# Leave outbound provider credentials unset to disable those channels entirely.
STAGING_SAFE_RECIPIENTS=

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_SUBJECT=mailto:you@example.com

# Secret guarding the digest cron endpoint (/api/cron/email-digest)
CRON_SECRET=your_long_random_secret

# Staging cron stays denied even with CRON_SECRET unless this is explicitly true.
STAGING_CRON_ENABLED=false
